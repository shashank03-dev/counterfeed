# Copy to .env (never commit .env).
# SmartSpectra API key from https://physiology.presagetech.com/ — read by the desktop app's main process only.
SMARTSPECTRA_API_KEY=

# Signaling server the desktop app connects to (ws:// for local dev, wss:// in production).
SIGNAL_URL=ws://localhost:8787

# Optional TURN relay. Some networks (corporate, mobile, symmetric NAT) need one for calls to connect.
TURN_URL=
TURN_USER=
TURN_PASS=

# Signaling server port (apps/signal).
PORT=8787
