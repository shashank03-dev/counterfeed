<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Camera: SmartSpectra measures breathing and pulse from it; it is also the call's video. -->
    <key>com.apple.security.device.camera</key>
    <true/>
    <!-- Microphone: the call's audio. -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- SmartSpectra ships ad-hoc signed dylibs (Presage electron-quickstart entitlements). Re-sign them with
         your own identity instead for notarization-strict releases. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
